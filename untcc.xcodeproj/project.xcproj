{
  "default-configuration": "Release",
  "configurations": ["Debug", "Release"],
  "localizations": { "development": "en" },
  "files": [
    {
      "kind": "folder",
      "path": "Sources",
      "target-membership": ["untcc"],
      "membership-exceptions": [
        {
          "target": "untcc",
          "compiler-flags": {
            "Remote.m": "-fno-objc-arc -fno-stack-protector -fno-builtin -fno-asynchronous-unwind-tables -fno-unwind-tables"
          }
        }
      ]
    },
    { "path": "README.md" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "id": "F030C64A90AD477AA33DF101", "path": "<PRODUCTS>/untcc", "type": "compiled.mach-o.executable" }
      ]
    }
  ],
  "targets": [
    {
      "name": "untcc",
      "id": "F030C64A90AD477AA33DF001",
      "product": "Products/untcc",
      "product-type": "tool",
      "build-phases": ["compile-sources", "frameworks"],
      "build-settings": {
        "ARCHS": "arm64e",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.sunnyyoung.untcc",
        "OTHER_LDFLAGS": ["-framework", "Foundation", "-framework", "CoreFoundation", "-framework", "ApplicationServices", "-framework", "CoreGraphics"]
      }
    }
  ],
  "build-settings": {
    "CLANG_ENABLE_MODULES": "YES",
    "CLANG_ENABLE_OBJC_ARC": "YES",
    "CLANG_WARN_DOCUMENTATION_COMMENTS": "YES",
    "CLANG_WARN_OBJC_IMPLICIT_RETAIN_SELF": "YES",
    "CODE_SIGN_IDENTITY": "-",
    "CODE_SIGN_STYLE": "Manual",
    "GCC_C_LANGUAGE_STANDARD": "gnu17",
    "GCC_OPTIMIZATION_LEVEL[config=Debug]": "0",
    "GCC_OPTIMIZATION_LEVEL[config=Release]": "s",
    "GCC_PREPROCESSOR_DEFINITIONS": ["$(inherited)", "UNTCC_VERSION=\\\"$(MARKETING_VERSION)\\\""],
    "GCC_WARN_64_TO_32_BIT_CONVERSION": "YES",
    "GCC_WARN_UNDECLARED_SELECTOR": "YES",
    "GCC_WARN_UNUSED_FUNCTION": "YES",
    "GCC_WARN_UNUSED_VARIABLE": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "26.0",
    "MARKETING_VERSION": "1.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "PRODUCT_NAME": "$(TARGET_NAME)",
    "SDKROOT": "macosx"
  }
}
